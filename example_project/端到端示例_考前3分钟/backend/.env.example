# 复制为 .env(本地),或填进 Railway/Vercel 的 Variables(线上)。
# .env 已被 .gitignore —— 绝不提交,绝不进前端。

# 必填:你的 OpenRouter key(和 0_agent_basic / 1_claude_code_basic 用的是同一个)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选:换模型(默认低延迟的 haiku;必须是 OpenRouter 有效 slug)
MODEL=anthropic/claude-haiku-4.5

# 可选:上线后把 * 收紧成你的前端域名,例如 https://yourname.github.io
CORS_ORIGINS=*
